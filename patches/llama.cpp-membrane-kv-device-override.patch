+        // [EXPERIMENTAL, MEMBRANE] optional per-layer KV cache DEVICE
+        // override, queried once per layer (for BOTH its K and V
+        // tensors together) at context-construction time -- lets the KV
+        // cache for a layer be placed on a different backend device than
+        // that layer's own model weights (model.dev_layer(il), which
+        // continues to govern weight placement only and is passed in
+        // here as default_dev). NULL leaves behavior identical to
+        // upstream (KV follows the same device as weights, exactly as
+        // before this field existed). If the callback itself returns
+        // NULL for a given layer, default_dev is used for that layer's
+        // KV -- a safe fallback, never a hard failure from a NULL
+        // return alone. Only honored for the standard, non-SWA,
+        // non-hybrid llama_kv_cache construction path (same scope
+        // restriction as kv_type_override above).
+        ggml_backend_dev_t (*kv_dev_override)(int32_t il,
+                ggml_backend_dev_t default_dev, void * user_data);
+        void * kv_dev_override_ud;
+
         // Abort callback
         // if it returns true, execution of llama_decode() will be aborted
         // currently works only with CPU execution
