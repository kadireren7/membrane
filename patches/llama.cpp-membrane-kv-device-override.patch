     const  layer_share_cb & share,
     ggml_type (*kv_type_override)(int32_t il, bool is_v, void * user_data),
-    void * kv_type_override_ud) :
+    void * kv_type_override_ud,
+    ggml_backend_dev_t (*kv_dev_override)(int32_t il,
+            ggml_backend_dev_t default_dev, void * user_data),
+    void * kv_dev_override_ud) :
     model(model), hparams(hparams), v_trans(v_trans),
     n_seq_max(n_seq_max), n_stream(unified ? 1 : n_seq_max), n_pad(n_pad), n_swa(n_swa), swa_type(swa_type),
     other(static_cast<llama_kv_cache *>(mem_other)),
@@ -211,13 +214,34 @@ llama_kv_cache::llama_kv_cache(
 
         const char * dev_name = "CPU";
 
+        ggml_backend_dev_t default_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
         ggml_backend_buffer_type_t buft = ggml_backend_cpu_buffer_type();
 
         if (offload) {
-            auto * dev = model.dev_layer(il);
-            buft = ggml_backend_dev_buffer_type(dev);
-
-            dev_name = ggml_backend_dev_name(dev);
+            default_dev = model.dev_layer(il);
+            buft = ggml_backend_dev_buffer_type(default_dev);
+
+            dev_name = ggml_backend_dev_name(default_dev);
+        }
+
+        // [MEMBRANE] optional per-layer KV device override -- default_dev
+        // above is exactly the device upstream would have used for this
+        // layer's KV (the same device as its weights when offload==true,
+        // else CPU); the callback may redirect ONLY this layer's KV
+        // placement to a different device, leaving the layer's own
+        // weights on default_dev untouched (llama_kv_cache never moves
+        // weights -- it has no access to weight tensors at all). A NULL
+        // return from the callback falls back to default_dev, never a
+        // hard failure. buft is only recomputed when the override
+        // actually picks a different device, so the offload==false /
+        // no-override path is byte-for-byte the same buft value upstream
+        // would have produced.
+        if (kv_dev_override) {
+            ggml_backend_dev_t kv_dev = kv_dev_override(il, default_dev, kv_dev_override_ud);
+            if (kv_dev && kv_dev != default_dev) {
+                buft = ggml_backend_dev_buffer_type(kv_dev);
+                dev_name = ggml_backend_dev_name(kv_dev);
+            }
         }
 
         LLAMA_LOG_DEBUG("%s: layer %3d: dev = %s\n", __func__, il, dev_name);
