# Phase 17: safe uninstall -- removes exactly the files this build's own
# install() run recorded in install_manifest.txt. Never touches a
# directory (no rmdir, no recursive delete): a shared prefix like
# ~/.local or /usr/local may hold files this project didn't install,
# and this script must never remove anything it didn't itself put there.
#
# Generated by configure_file() from tools/membrane-run/CMakeLists.txt's
# "uninstall" custom target -- @CMAKE_CURRENT_BINARY_DIR@ etc. below are
# substituted at configure time, not read literally.

set(MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")

if(NOT EXISTS "${MANIFEST}")
  message(FATAL_ERROR
    "Cannot uninstall: ${MANIFEST} does not exist. Run "
    "'cmake --install <build-dir>' from this same build directory at "
    "least once first -- uninstall only ever removes what that exact "
    "install run recorded, never a guess at what might be installed.")
endif()

file(STRINGS "${MANIFEST}" MEMBRANE_INSTALLED_FILES)
set(MEMBRANE_UNINSTALL_MISSING "")
set(MEMBRANE_UNINSTALL_FAILED "")
foreach(_file IN LISTS MEMBRANE_INSTALLED_FILES)
  if(EXISTS "${_file}" OR IS_SYMLINK "${_file}")
    message(STATUS "Removing: ${_file}")
    file(REMOVE "${_file}")
    # file(REMOVE) does not fail or report an error if the OS-level
    # removal itself fails (e.g. a read-only file/directory) -- it
    # would otherwise be possible for this loop to print "Removing:"
    # for every entry and then "Uninstall complete" below while a file
    # is still actually there. Check explicitly rather than trust
    # file(REMOVE)'s silence.
    if(EXISTS "${_file}" OR IS_SYMLINK "${_file}")
      list(APPEND MEMBRANE_UNINSTALL_FAILED "${_file}")
    endif()
  else()
    list(APPEND MEMBRANE_UNINSTALL_MISSING "${_file}")
  endif()
endforeach()

if(MEMBRANE_UNINSTALL_FAILED)
  message(FATAL_ERROR
    "Failed to remove the following installed file(s) (permission "
    "denied, or some other OS-level removal failure): "
    "${MEMBRANE_UNINSTALL_FAILED}")
endif()

if(MEMBRANE_UNINSTALL_MISSING)
  list(LENGTH MEMBRANE_UNINSTALL_MISSING MEMBRANE_UNINSTALL_MISSING_COUNT)
  message(STATUS
    "${MEMBRANE_UNINSTALL_MISSING_COUNT} file(s) from the manifest were "
    "already absent (not an error -- already removed or never created).")
endif()

message(STATUS "Uninstall complete. Installation directories themselves "
  "(bin/, lib/, share/membrane/, ...) were left in place -- remove them "
  "manually only if you're sure nothing else uses that prefix.")
